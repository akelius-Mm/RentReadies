# Claude credentials — use ONE of these:
#  1. Your Claude login (recommended for personal use): run `ant auth login` on this machine and
#     leave ANTHROPIC_API_KEY unset. The server picks up the login and refreshes it automatically.
#  2. An API key from https://console.anthropic.com:
# ANTHROPIC_API_KEY=

# Required whenever the server is reachable from your phone or the internet.
# Everyone using the app enters this once; it keeps others from using your Claude account.
APP_PASSCODE=

PORT=8787
